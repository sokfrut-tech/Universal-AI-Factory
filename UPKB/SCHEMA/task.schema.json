{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPKB Task Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "title",
    "status",
    "priority",
    "owner",
    "next_action",
    "evidence",
    "verification_status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]+$"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "pending",
        "completed",
        "blocked"
      ]
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "REPORTED",
        "PLANNED",
        "UNKNOWN"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
