{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sokfrut-tech/Universal-AI-Factory/blob/main/coordination/shared/task-status.schema.json",
  "title": "Universal AI Factory task status event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "correlation_id",
    "source_message",
    "provider",
    "status",
    "updated_at",
    "attempt",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "source_message": {
      "type": "string",
      "pattern": "^coordination/(claude|gemini)/inbox/[A-Za-z0-9._-]+\\.md$"
    },
    "provider": {
      "enum": [
        "claude",
        "gemini"
      ]
    },
    "status": {
      "enum": [
        "received",
        "accepted",
        "queued",
        "dispatched",
        "running",
        "review",
        "done",
        "partial",
        "blocked",
        "failed",
        "rejected",
        "cancelled"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "branch": {
      "type": "string",
      "maxLength": 256
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pull_request_url": {
      "type": "string",
      "format": "uri"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "log",
              "artifact",
              "commit",
              "pull_request",
              "test",
              "report"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "result"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence_reference": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "failure_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence",
          "acceptance_checks"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "acceptance_checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence",
          "not_verified"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "not_verified": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure_reason"
        ]
      }
    }
  ]
}
